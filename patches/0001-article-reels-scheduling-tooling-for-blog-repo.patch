@@ -0,0 +1,347 @@
+/* Article Reels Dashboard — styles */
+
+:root {
+  --bg: #0f1115;
+  --bg-card: #181b21;
+  --bg-header: #0a0c10;
+  --border: #2a2f3a;
+  --text: #e6e8ee;
+  --text-muted: #8b9099;
+  --accent: #6366f1;
+  --accent-hover: #818cf8;
+  --accent-dim: rgba(99,102,241,.12);
+  --bg-card-hover: #1e222b;
+  --danger: #f87171;
+  --radius: 12px;
+  --radius-sm: 8px;
+  --font: 'Segoe UI', system-ui, -apple-system, sans-serif;
+}
+
+* { box-sizing: border-box; margin: 0; padding: 0; }
+
+body {
+  font-family: var(--font);
+  background: var(--bg);
+  color: var(--text);
+  line-height: 1.6;
+  min-height: 100vh;
+}
+
+header {
+  background: var(--bg-header);
+  border-bottom: 1px solid var(--border);
+  padding: 20px 28px;
+  position: sticky;
+  top: 0;
+  z-index: 10;
+}
+header .inner {
+  max-width: 1280px;
+  margin: 0 auto;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 16px;
+}
+header h1 {
+  font-size: 1.5rem;
+  font-weight: 700;
+  letter-spacing: -0.02em;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+header h1 .logo { font-size: 1.6rem; }
+header .subtitle {
+  color: var(--text-muted);
+  font-size: .9rem;
+  margin-top: 2px;
+}
+
+main {
+  max-width: 1280px;
+  margin: 0 auto;
+  padding: 28px;
+  display: flex;
+  flex-direction: column;
+  gap: 28px;
+}
+
+.stats {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
+  gap: 14px;
+}
+.stat-card {
+  background: var(--bg-card);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  padding: 16px 18px;
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  transition: border-color .15s, transform .15s;
+}
+.stat-card:hover {
+  border-color: var(--accent);
+  transform: translateY(-2px);
+}
+.stat-card-value {
+  font-size: 1.6rem;
+  font-weight: 700;
+  color: var(--accent);
+  line-height: 1.2;
+}
+.stat-card-label {
+  color: var(--text-muted);
+  font-size: .85rem;
+  text-transform: uppercase;
+  .post-age { color: var(--text-muted); }
+  .post-reactions, .post-shares { font-size: .8rem; }
+  .post-reactions .heart::before { content: '\2665'; color: #34d399; }
+  .post-shares .share::before { content: '\1f4e4'; color: #6366f1; }
+
+  letter-spacing: .04em;
+}
+
+.panel {
+  background: var(--bg-card);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  padding: 22px 24px;
+}
+.panel h2 {
+  font-size: 1.15rem;
+  font-weight: 600;
+  margin-bottom: 4px;
+}
+.panel-sub {
+  color: var(--text-muted);
+  font-size: .88rem;
+  margin-bottom: 16px;
+}
+
+.reel-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
+  gap: 16px;
+}
+.reel-card {
+  background: var(--bg);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-sm);
+  padding: 18px 20px;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  transition: border-color .15s, background .15s;
+}
+.reel-card:hover {
+  border-color: var(--accent);
+  background: var(--bg-card-hover);
+}
+.reel-card-top {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+.reel-icon { font-size: 1.5rem; }
+.reel-index {
+  background: var(--accent-dim);
+  color: var(--accent);
+  font-size: .78rem;
+  font-weight: 600;
+  padding: 3px 10px;
+  border-radius: 999px;
+}
+.reel-title {
+  font-size: 1.05rem;
+  font-weight: 600;
+}
+.reel-desc {
+  color: var(--text-muted);
+  font-size: .9rem;
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+.reel-meta {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 10px;
+  font-size: .82rem;
+  color: var(--text-muted);
+}
+.reel-meta .post-id {
+  color: var(--text-muted);
+  font-family: 'Consolas', monospace;
+  font-size: .78rem;
+  max-width: 200px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.countdown {
+  margin-top: 8px;
+  font-family: 'Consolas', monospace;
+  font-size: .85rem;
+  font-weight: 600;
+  padding: 8px 12px;
+  background: var(--bg);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-sm);
+  text-align: center;
+  min-width: 140px;
+}
+
+.pages-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
+  gap: 18px;
+}
+.page-card {
+  background: var(--bg);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-sm);
+  padding: 16px 18px;
+}
+.page-card-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  margin-bottom: 12px;
+}
+.page-card-head h3 {
+  font-size: 1rem;
+  font-weight: 600;
+}
+.page-card-head .badge {
+  background: var(--accent-dim);
+  color: var(--accent);
+  font-size: .75rem;
+  font-weight: 600;
+  padding: 3px 10px;
+  border-radius: 999px;
+}
+.page-stats {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+  margin-bottom: 14px;
+  padding-bottom: 12px;
+  border-bottom: 1px solid var(--border);
+}
+.stat {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+.stat-value {
+  font-size: 1.1rem;
+  font-weight: 700;
+  color: var(--accent);
+}
+.stat-label {
+  font-size: .72rem;
+  color: var(--text-muted);
+  text-transform: uppercase;
+  letter-spacing: .04em;
+}
+.post-list {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+.post-item {
+  border-bottom: 1px solid var(--border);
+  padding: 10px 0;
+}
+.post-item:last-child { border-bottom: none; }
+.post-body {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+.post-message {
+  font-size: .88rem;
+  color: var(--text);
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+.post-meta {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px;
+  font-size: .72rem;
+  color: var(--text-muted);
+}
+.post-meta a {
+  color: var(--accent);
+  text-decoration: none;
+}
+.post-meta a:hover {
+  text-decoration: underline;
+}
+.post-age { color: var(--text-muted); }
+.post-reactions, .post-shares { font-size: .8rem; }
+
+.empty {
+  color: var(--text-muted);
+  font-size: .9rem;
+  text-align: center;
+  padding: 20px;
+}
+
+.footer {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 12px;
+  padding: 18px 28px;
+  border-top: 1px solid var(--border);
+  background: var(--bg-header);
+}
+.footer .hint { color: var(--text-muted); font-size: .8rem; }
+.footer code {
+  background: var(--bg);
+  padding: 1px 6px;
+  border-radius: 4px;
+  font-size: .8em;
+  color: var(--text-muted);
+}
+.btn {
+  background: var(--accent);
+  color: #fff;
+  border: none;
+  padding: 8px 18px;
+  border-radius: var(--radius-sm);
+  font-weight: 600;
+  font-size: .88rem;
+  cursor: pointer;
+  transition: background .15s;
+}
+.btn:hover { background: var(--accent-hover); }
+
+code { background: var(--bg); padding: 1px 6px; border-radius: 4px; color: var(--accent); }
+
+@media (max-width: 720px) {
+  main { padding: 16px; }
+  header { padding: 14px 16px; }
+  .footer { flex-direction: column; align-items: flex-start; }
+}
+
+.panel-sub code {
+  background: var(--bg);
+  padding: 1px 6px;
+  border-radius: 4px;
+  font-size: .82em;
+  color: var(--accent);
+}
diff --git a/article-reels/dashboard.js b/article-reels/dashboard.js
new file mode 100644
index 0000000..a4ec5e6
--- /dev/null
+++ b/article-reels/dashboard.js
@@ -0,0 +1,185 @@
+// Article Reels Dashboard - client-side JS
+// Reads window.__dashboardData (embedded by generate_dashboard.py)
+// and powers live countdown timers, post age updates, and refresh.
+
+(function () {
+  "use strict";
+
+  var state = {
+    reels: [],
+    pages: {},
+    recent_posts: []
+  };
+
+  // Populate state from the embedded JSON object.
+  function initState(data) {
+    if (!data) return;
+    if (Array.isArray(data.reels)) state.reels = data.reels;
+    if (data.pages_data) state.pages = data.pages_data;
+    if (Array.isArray(data.recent_posts)) {
+      state.recent_posts = data.recent_posts;
+    }
+  }
+
+  function pad(n) { return n < 10 ? "0" + n : "" + n; }
+
+  function formatCountdown(dtStr) {
+    var dt = new Date(dtStr);
+    if (isNaN(dt.getTime())) return "-";
+    var diff = dt.getTime() - Date.now();
+    if (diff <= 0) {
+      return '<span style="color:#f87171;font-weight:700;">now</span>';
+    }
+    var days = Math.floor(diff / 86400000);
+    var hours = Math.floor((diff % 86400000) / 3600000);
+    var mins = Math.floor((diff % 3600000) / 60000);
+    var secs = Math.floor((diff % 60000) / 1000);
+    var parts = [];
+    if (days > 0) parts.push(days + "d");
+    if (hours > 0) parts.push(hours + "h");
+    if (mins > 0) parts.push(mins + "m");
+    parts.push(secs + "s");
+    var color = (days > 0 || hours > 0) ? "#fbbf24" : "#34d399";
+    return '<span style="color:' + color + ';font-weight:600;">in '
+      + parts.join(" ") + "</span>";
+  }
+
+  // Reel countdown ids are 1-based (cd-1, cd-2, ...).
+  function updateCountdowns() {
+    var els = document.querySelectorAll(".countdown");
+    for (var i = 0; i < els.length; i++) {
+      var el = els[i];
+      var idx = parseInt(el.id.replace("cd-", ""), 10);
+      var reel = state.reels[idx - 1];
+      if (reel) {
+        el.innerHTML = formatCountdown(reel.when);
+      }
+    }
+  }
+
+  function timeAgo(dt) {
+    if (isNaN(dt.getTime())) return "-";
+    var diff = Date.now() - dt.getTime();
+    if (diff < 0) return "future";
+    if (diff < 60000) return "just now";
+    var m = Math.floor(diff / 60000);
+    if (m < 60) return m + "m ago";
+    var h = Math.floor(m / 60);
+    if (h < 24) return h + "h ago";
+    var d = Math.floor(h / 24);
+    if (d < 30) return d + "d ago";
+    return Math.floor(d / 30) + "mo ago";
+  }
+
+  function escapeHtml(s) {
+    return String(s == null ? "" : s)
+      .replace(/&/g, "&amp;")
+      .replace(/</g, "&lt;")
+      .replace(/>/g, "&gt;")
+      .replace(/"/g, "&quot;")
+      .replace(/'/g, "&#39;");
+  }
+
+
+  function reRenderPosts() {
+    var cards = document.querySelectorAll(".page-card");
+    for (var i = 0; i < cards.length; i++) {
+      var card = cards[i];
+      var key = card.getAttribute("data-page-key");
+      var data = state.pages[key];
+      if (!data) continue;
+      var list = card.querySelector(".post-list");
+      if (!list) continue;
+      var posts = (data.posts || []).slice(0, 8);
+      if (!posts.length) {
+        list.innerHTML = '<p class="empty">No posts scraped yet.</p>';
+        continue;
+      }
+      var html = "";
+      for (var j = 0; j < posts.length; j++) {
+        var p = posts[j];
+        var msg = (p.message || "").trim().slice(0, 200);
+        var permalink = p.permalink_url || "#";
+        var age = timeAgo(new Date(p.created_time || ""));
+        var reaction = (p.reactions && p.reactions.summary)
+          ? p.reactions.summary.total_count || 0 : 0;
+        var shares = (p.shares && p.shares.count)
+          ? p.shares.count : 0;
+        html += '<div class="post-item">'
+          + '<div class="post-body">'
+          + '<div class="post-message">'
+          + (msg ? escapeHtml(msg) : "<i>[no message]</i>")
+          + "</div>"
+          + '<div class="post-meta">'
+          + '<a href="' + escapeHtml(permalink)
+          + '" target="_blank" rel="noopener">'
+          + escapeHtml(p.id || "unknown") + "</a>"
+          + '<span class="post-age">' + escapeHtml(age) + "</span>"
+          + '<span class="post-reactions"><i class="heart"></i> '
+          + reaction + "</span>"
+          + '<span class="post-shares"><i class="share"></i>'
+          + shares + "</span>"
+          + "</div></div></div>";
+      }
+      list.innerHTML = html;
+    }
+  }
+
+  function refreshClock() {
+    var el = document.getElementById("last-updated-time");
+    if (el) {
+      var now = new Date();
+      el.textContent = now.getUTCFullYear() + "-"
+        + pad(now.getUTCMonth() + 1) + "-"
+        + pad(now.getUTCDate()) + " "
+        + pad(now.getUTCHours()) + ":"
+        + pad(now.getUTCMinutes()) + ":"
+        + pad(now.getUTCSeconds()) + " UTC";
+    }
+    updateCountdowns();
+    reRenderPosts();
+  }
+
+  function refreshData() {
+    var btn = document.getElementById("refresh-btn");
+    if (btn) {
+      btn.disabled = true;
+      btn.textContent = "Updating...";
+    }
+    fetch("dashboard.html?_=" + Date.now())
+      .then(function (r) { return r.text(); })
+      .then(function (html) {
+        var m = html.match(
+          /window\.__dashboardData = (\{[\s\S]*?\});\s*<\/script>/);
+        if (m) {
+          try {
+            var data = JSON.parse(m[1]);
+            initState(data);
+            refreshClock();
+          } catch (e) { /* keep current view */ }
+        }
+      })
+      .catch(function () { /* offline: keep current view */ })
+      .then(function () {
+        if (btn) {
+          btn.disabled = false;
+          btn.textContent = "Refresh data";
+        }
+      });
+  }
+
+  function initDashboard() {
+    initState(window.__dashboardData);
+    refreshClock();
+    setInterval(refreshClock, 1000);
+    setInterval(reRenderPosts, 30000);
+    var btn = document.getElementById("refresh-btn");
+    if (btn) btn.addEventListener("click", refreshData);
+  }
+
+  if (document.readyState === "loading") {
+    document.addEventListener("DOMContentLoaded", initDashboard);
+  } else {
+    initDashboard();
+  }
+})();
